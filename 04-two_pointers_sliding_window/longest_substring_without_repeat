def length_of_longest_substring(text):
    last, left, best = {}, 0, 0
    for right, char in enumerate(text):
        if char in last and last[char] >= left:
            left = last[char] + 1
        last[char] = right
        best = max(best, right - left + 1)
    return best

if __name__ == "__main__":
    print(length_of_longest_substring("abcabcbb"))  # 3
