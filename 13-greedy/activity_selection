def select_activities(activities):
    selected = []
    for activity in sorted(activities, key=lambda item: item[1]):
        if not selected or activity[0] >= selected[-1][1]:
            selected.append(activity)
    return selected

if __name__ == "__main__":
    print(select_activities([(1, 3), (2, 4), (3, 5), (0, 6), (5, 7)]))
