def can_complete_circuit(gas, cost):
    if sum(gas) < sum(cost):
        return -1
    total = start = 0
    for i, amount in enumerate(gas):
        total += amount - cost[i]
        if total < 0:
            start, total = i + 1, 0
    return start if start < len(gas) else -1

if __name__ == "__main__":
    print(can_complete_circuit([1, 2, 3, 4, 5], [3, 4, 5, 1, 2]))  # 3
