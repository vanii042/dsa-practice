def search_range(nums, target):
    def bound(first):
        left, right, answer = 0, len(nums) - 1, -1
        while left <= right:
            mid = (left + right) // 2
            if nums[mid] == target:
                answer = mid
                if first:
                    right = mid - 1
                else:
                    left = mid + 1
            elif nums[mid] < target:
                left = mid + 1
            else:
                right = mid - 1
        return answer
    return [bound(True), bound(False)]

if __name__ == "__main__":
    print(search_range([5, 7, 7, 8, 8, 10], 8))  # [3, 4]
