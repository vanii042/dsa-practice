def bubble_sort(nums):
    nums = nums[:]
    for end in range(len(nums) - 1, 0, -1):
        swapped = False
        for i in range(end):
            if nums[i] > nums[i + 1]:
                nums[i], nums[i + 1] = nums[i + 1], nums[i]
                swapped = True
        if not swapped:
            break
    return nums

if __name__ == "__main__":
    print(bubble_sort([5, 1, 4, 2, 8]))
