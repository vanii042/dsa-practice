class MinStack:
    def __init__(self):
        self.values, self.mins = [], []
    def push(self, value):
        self.values.append(value)
        if not self.mins or value <= self.mins[-1]:
            self.mins.append(value)
    def pop(self):
        if not self.values:
            raise IndexError("pop from empty stack")
        value = self.values.pop()
        if value == self.mins[-1]:
            self.mins.pop()
        return value
    def get_min(self):
        if not self.mins:
            raise IndexError("minimum of empty stack")
        return self.mins[-1]

if __name__ == "__main__":
    s = MinStack()
    s.push(3); s.push(1); s.push(2)
    print(s.get_min())  # 1
