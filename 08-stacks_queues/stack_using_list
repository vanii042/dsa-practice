class Stack:
    def __init__(self):
        self.items = []
    def push(self, value):
        self.items.append(value)
    def pop(self):
        if not self.items:
            raise IndexError("pop from empty stack")
        return self.items.pop()
    def is_empty(self):
        return not self.items

if __name__ == "__main__":
    stack = Stack()
    stack.push(10); stack.push(20)
    print(stack.pop())  # 20
